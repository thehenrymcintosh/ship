#!/usr/bin/env bash
# Prints: merged | comments | waiting
set -euo pipefail
pr="$1"
state=$(gh pr view "$pr" --json state -q .state)
[ "$state" = "MERGED" ] && { echo merged; exit 0; }
marker="${SHIP_RUN_DIR:-/tmp}/.pr-comments-seen"
count=$(gh pr view "$pr" --json comments,reviews -q '(.comments|length)+(.reviews|length)')
seen=$(cat "$marker" 2>/dev/null || echo 0)
if [ "$count" -gt "$seen" ]; then echo "$count" > "$marker"; echo comments; else echo waiting; fi
